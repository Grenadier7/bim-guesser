# Eigene ngrok-Adresse (Dashboard -> Domains). Leer lassen = nur lokal.
NGROK_URL=https://dein-name.ngrok-free.dev

# Optional: Passwortschutz (mind. 8 Zeichen). Mitspieler brauchen Benutzer + Passwort.
# NGROK_USER=wien
# NGROK_PASSWORD=

# PORT=3000

# Accounts – „Passwort vergessen“ per E-Mail (optional; ohne ist nur der Reset aus).
# Links in der Mail zeigen auf NGROK_URL bzw. PUBLIC_URL.
# SMTP_URL=smtps://benutzer:passwort@mail.example.org:465
# MAIL_FROM=BimGuesser <noreply@example.org>
# PUBLIC_URL=https://dein-name.ngrok-free.dev
# Zum Ausprobieren ohne Mailserver: Mails landen als JSON-Zeilen in dieser Datei
# MAIL_FILE=data/mails.jsonl
